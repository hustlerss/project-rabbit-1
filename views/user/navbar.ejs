<!-- ═══════════════════════════════════════════════════════════
     PROJECT RABBIT — Global User Navbar (Redesigned & Premium)
     SaaS Theme: Centered Floating Pill, Glassmorphism, Neon Accents
     Redesigned by Antigravity Frontend Creative Director
 ════════════════════════════════════════════════════════════ -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800;900&display=swap" rel="stylesheet">

<style>
  /* ─── DESIGN SYSTEM VARIABLES ─── */
  :root {
    --bg-primary: #050816;
    --bg-secondary: #0b1020;
    --bg-tertiary: #111827;
    --accent-pink: #ff3b70;
    --accent-purple: #903bff;
    --accent-cyan: #00f0ff;
    --accent-gradient: linear-gradient(135deg, var(--accent-pink) 0%, var(--accent-purple) 50%, var(--accent-cyan) 100%);
    --btn-gradient: linear-gradient(135deg, var(--accent-pink) 0%, var(--accent-purple) 100%);
    --border-light: rgba(255, 255, 255, 0.08);
    --border-medium: rgba(255, 255, 255, 0.15);
    --text-primary: #ffffff;
    --text-secondary: rgba(255, 255, 255, 0.7);
    --text-muted: rgba(255, 255, 255, 0.45);
    --glass-bg: rgba(8, 9, 21, 0.65);
    --glass-blur: blur(24px);
  }

  /* ─── GLOBAL OVERRIDES (Instant site-wide redesign) ─── */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    background-color: var(--bg-primary) !important;
    color: var(--text-primary) !important;
    font-family: 'Inter', sans-serif !important;
    overflow-x: hidden;
    padding-top: 84px !important;
  }

  h1, h2, h3, h4, h5, h6, .h1, .h2, .h3, .h4, .h5, .h6, .fw-bold {
    font-family: 'Plus Jakarta Sans', sans-serif !important;
    font-weight: 800 !important;
    letter-spacing: -0.025em;
    color: var(--text-primary) !important;
  }

  /* Bootstrap Card Redesign Override */
  .card, .checkout-card, .order-card, .detail-card {
    background: rgba(11, 16, 32, 0.6) !important;
    backdrop-filter: var(--glass-blur) !important;
    -webkit-backdrop-filter: var(--glass-blur) !important;
    border: 1px solid var(--border-light) !important;
    border-radius: 20px !important;
    color: var(--text-primary) !important;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.4) !important;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1) !important;
    overflow: hidden;
  }
  .card:hover, .checkout-card:hover, .order-card:hover, .detail-card:hover {
    transform: translateY(-5px) !important;
    border-color: rgba(255, 59, 112, 0.28) !important;
    box-shadow: 0 20px 40px rgba(255, 59, 112, 0.1), 0 0 0 1px rgba(255, 59, 112, 0.05) !important;
  }
  .card-body { color: var(--text-primary) !important; padding: 22px !important; }
  .card-footer {
    background: transparent !important;
    border-top: 1px solid var(--border-light) !important;
    padding: 14px 22px !important;
  }
  .text-muted { color: var(--text-secondary) !important; }
  .text-muted.small { color: var(--text-muted) !important; }

  /* Premium Glowing Buttons */
  .btn-danger, .btn-primary {
    background: var(--btn-gradient) !important;
    border: none !important;
    color: #fff !important;
    border-radius: 14px !important;
    font-weight: 700 !important;
    padding: 12px 24px !important;
    font-size: 14px !important;
    box-shadow: 0 4px 18px rgba(255, 59, 112, 0.25) !important;
    transition: all 0.25s cubic-bezier(0.2, 1, 0.2, 1) !important;
  }
  .btn-danger:hover, .btn-primary:hover {
    transform: translateY(-2px) !important;
    box-shadow: 0 8px 22px rgba(255, 59, 112, 0.4) !important;
    filter: brightness(1.08);
  }
  .btn-outline-danger {
    background: rgba(255, 59, 112, 0.06) !important;
    border: 1px solid rgba(255, 59, 112, 0.25) !important;
    color: var(--accent-pink) !important;
    border-radius: 14px !important;
    font-weight: 600 !important;
    padding: 12px 24px !important;
    font-size: 14px !important;
    transition: all 0.25s !important;
  }
  .btn-outline-danger:hover {
    background: var(--btn-gradient) !important;
    border-color: transparent !important;
    color: #fff !important;
    transform: translateY(-2px) !important;
    box-shadow: 0 8px 22px rgba(255, 59, 112, 0.3) !important;
  }
  .btn-outline-secondary {
    background: rgba(255, 255, 255, 0.04) !important;
    border: 1px solid var(--border-light) !important;
    color: #fff !important;
    border-radius: 14px !important;
    padding: 12px 24px !important;
    font-size: 14px !important;
    font-weight: 500 !important;
    transition: all 0.25s !important;
  }
  .btn-outline-secondary:hover {
    background: rgba(255, 255, 255, 0.08) !important;
    border-color: var(--border-medium) !important;
    transform: translateY(-2px) !important;
  }

  /* Form Inputs styling */
  .form-control, .form-select, input[type="text"], input[type="email"], input[type="tel"], textarea, select {
    background: rgba(11, 16, 32, 0.4) !important;
    border: 1px solid var(--border-light) !important;
    color: #fff !important;
    border-radius: 14px !important;
    padding: 12px 18px !important;
    transition: all 0.2s ease !important;
  }
  .form-control:focus, .form-select:focus, input[type="text"]:focus, input[type="email"]:focus, input[type="tel"]:focus, textarea:focus, select:focus {
    background: rgba(11, 16, 32, 0.6) !important;
    border-color: rgba(255, 59, 112, 0.45) !important;
    box-shadow: 0 0 0 4px rgba(255, 59, 112, 0.12) !important;
    color: #fff !important;
    outline: none !important;
  }

  /* Browser Autofill styling overrides */
  input:-webkit-autofill,
  input:-webkit-autofill:hover, 
  input:-webkit-autofill:focus, 
  input:-webkit-autofill:active {
    -webkit-box-shadow: 0 0 0 30px #0b1020 inset !important;
    -webkit-text-fill-color: #ffffff !important;
    transition: background-color 5000s ease-in-out 0s;
  }

  /* Badges */
  .badge.bg-danger {
    background: rgba(255, 59, 112, 0.08) !important;
    border: 1px solid rgba(255, 59, 112, 0.25) !important;
    color: var(--accent-pink) !important;
    font-size: 11px !important;
    font-weight: 700 !important;
    padding: 6px 12px !important;
    border-radius: 20px !important;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  /* Tables */
  .table {
    --bs-table-bg: transparent !important;
    color: var(--text-primary) !important;
    border-color: var(--border-light) !important;
  }
  .table th {
    font-weight: 700 !important;
    text-transform: uppercase;
    font-size: 11px !important;
    letter-spacing: 1px !important;
    border-bottom: 2px solid var(--border-light) !important;
    color: var(--text-muted) !important;
    padding: 14px 12px !important;
  }
  .table td {
    padding: 16px 12px !important;
    border-bottom: 1px solid var(--border-light) !important;
    vertical-align: middle !important;
  }

  /* ─── FLOATING PILL NAVBAR ─── */
  .pr-navbar {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 9999;
    padding: 18px 0;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  /* Pill shaped inner dock */
  .pr-navbar-inner-wrapper {
    max-width: 1120px;
    margin: 0 auto;
    padding: 6px 8px 6px 22px;
    background: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border: 1px solid var(--border-light);
    border-radius: 50px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.1);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  .pr-navbar.scrolled {
    padding: 10px 0;
  }
  .pr-navbar.scrolled .pr-navbar-inner-wrapper {
    background: rgba(8, 9, 21, 0.88);
    border-color: rgba(255, 59, 112, 0.2);
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.45);
  }

  /* ─── LOGO AREA ─── */
  .pr-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    flex-shrink: 0;
  }
  .pr-brand-icon {
    width: 36px; height: 36px;
    background: linear-gradient(135deg, var(--accent-pink), var(--accent-purple));
    border-radius: 11px;
    display: flex; align-items: center; justify-content: center;
    font-size: 18px;
    box-shadow: 0 4px 14px rgba(255, 59, 112, 0.35);
    transition: transform 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  .pr-brand:hover .pr-brand-icon {
    transform: rotate(-10deg) scale(1.08);
  }
  .pr-brand-name {
    font-size: 18px;
    font-weight: 900;
    color: #fff;
    letter-spacing: -0.4px;
  }
  .pr-brand-name span {
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* ─── NAV LINKS ─── */
  .pr-nav-links {
    display: flex;
    align-items: center;
    gap: 1px;
    list-style: none;
    margin: 0; padding: 0;
  }
  .pr-nav-links a {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 12.5px;
    font-weight: 600;
    padding: 8px 10px;
    border-radius: 30px;
    transition: all 0.25s cubic-bezier(0.2, 1, 0.2, 1);
    white-space: nowrap;
    position: relative;
  }
  .pr-nav-links a:hover {
    color: #fff;
  }
  
  /* Underline active transitions */
  .pr-nav-links a::after {
    content: '';
    position: absolute;
    bottom: 2px; left: 50%; width: 0; height: 1.5px;
    background: var(--accent-pink);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    transform: translateX(-50%);
  }
  .pr-nav-links a:hover::after,
  .pr-nav-links a.active::after {
    width: 50%;
  }
  
  .pr-nav-links a.active {
    color: var(--accent-pink);
  }

  /* ─── CART TRIGGER ─── */
  .pr-btn-cart {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: var(--btn-gradient);
    color: #fff !important;
    padding: 9px 18px !important;
    border-radius: 30px !important;
    font-weight: 700 !important;
    font-size: 13px !important;
    box-shadow: 0 4px 14px rgba(255, 59, 112, 0.3);
    transition: all 0.25s cubic-bezier(0.2, 1, 0.2, 1) !important;
    border: none !important;
  }
  .pr-btn-cart:hover {
    filter: brightness(1.1);
    transform: translateY(-1.5px) !important;
    box-shadow: 0 6px 18px rgba(255, 59, 112, 0.45) !important;
  }

  /* ─── HAMBURGER ─── */
  .pr-hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    border-radius: 50px;
    transition: background 0.2s;
  }
  .pr-hamburger:hover { background: rgba(255,255,255,0.06); }
  .pr-hamburger span {
    display: block;
    width: 20px; height: 2px;
    background: #fff;
    border-radius: 2px;
    transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
  }
  .pr-hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .pr-hamburger.open span:nth-child(2) { opacity: 0; transform: scaleX(0); }
  .pr-hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* ─── MOBILE DRAWER MENU ─── */
  .pr-mobile-menu {
    display: none;
    flex-direction: column;
    background: rgba(8, 9, 21, 0.98);
    backdrop-filter: blur(30px);
    border: 1px solid var(--border-light);
    border-radius: 24px;
    margin: 8px 16px 0;
    padding: 14px;
    gap: 5px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
    animation: slideDown 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .pr-mobile-menu.open { display: flex; }
  .pr-mobile-menu a {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 13.5px;
    font-weight: 600;
    padding: 10px 14px;
    border-radius: 12px;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .pr-mobile-menu a:hover { color: #fff; background: rgba(255,255,255,0.05); }
  .pr-mobile-menu a.cart-mobile {
    background: var(--btn-gradient);
    color: #fff;
    margin-top: 8px;
    justify-content: center;
    font-weight: 700;
    box-shadow: 0 4px 14px rgba(255, 59, 112, 0.25);
    border-radius: 30px;
  }

  @keyframes slideDown {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Responsive styling */
  @media (max-width: 991px) {
    .pr-nav-links { display: none; }
    .pr-hamburger { display: flex; }
    .pr-navbar-inner-wrapper { margin: 0 16px; padding: 6px 6px 6px 18px; }
  }
  @media (min-width: 992px) {
    .pr-mobile-menu { display: none !important; }
  }
</style>

<header>
  <nav class="pr-navbar" id="prNavbar" role="navigation" aria-label="Main navigation">
    <div class="pr-navbar-inner-wrapper">

      <!-- Brand -->
      <a href="/" class="pr-brand" id="navBrand">
        <div class="pr-brand-icon">🐇</div>
        <span class="pr-brand-name">Project<span>Hub</span></span>
      </a>

      <!-- Desktop Nav Links -->
      <ul class="pr-nav-links" id="desktopNav">
        <li><a href="/" id="navHome"><i class="fas fa-home fa-xs" style="margin-right:4px;opacity:.7;"></i>Home</a></li>
        <li><a href="/ready-project-details" id="navReady"><i class="fas fa-rocket fa-xs" style="margin-right:4px;opacity:.7;"></i>Ready</a></li>
        <li><a href="/mini-project-details" id="navMini"><i class="fas fa-cubes fa-xs" style="margin-right:4px;opacity:.7;"></i>Mini</a></li>
        <li><a href="/bundle-project-details" id="navBundle"><i class="fas fa-gift fa-xs" style="margin-right:4px;opacity:.7;"></i>Bundle</a></li>
        <li><a href="/customized-project-details" id="navCustom"><i class="fas fa-pencil-ruler fa-xs" style="margin-right:4px;opacity:.7;"></i>Custom</a></li>
        <li><a href="/roadmaps" id="navRoadmap"><i class="fas fa-map fa-xs" style="margin-right:4px;opacity:.7;"></i>Roadmaps</a></li>
        <li><a href="/contact" id="navContact"><i class="fas fa-envelope fa-xs" style="margin-right:4px;opacity:.7;"></i>Contact</a></li>
        <li><a href="/my-orders" id="navOrders"><i class="fas fa-box fa-xs" style="margin-right:4px;opacity:.7;"></i>My Orders</a></li>
        <li><a href="/checkout" class="pr-btn-cart" id="navCart"><i class="fas fa-shopping-cart"></i> Cart</a></li>
      </ul>

      <!-- Hamburger (Mobile Only) -->
      <button class="pr-hamburger" id="prHamburger" aria-label="Toggle menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>

    <!-- Mobile Menu -->
    <div class="pr-mobile-menu" id="prMobileMenu" role="menu">
      <a href="/"><i class="fas fa-home fa-fw"></i> Home</a>
      <a href="/ready-project-details"><i class="fas fa-rocket fa-fw"></i> Ready Projects</a>
      <a href="/mini-project-details"><i class="fas fa-cubes fa-fw"></i> Mini Projects</a>
      <a href="/bundle-project-details"><i class="fas fa-gift fa-fw"></i> Bundle Projects</a>
      <a href="/customized-project-details"><i class="fas fa-pencil-ruler fa-fw"></i> Custom Projects</a>
      <a href="/roadmaps"><i class="fas fa-map fa-fw"></i> Roadmaps</a>
      <a href="/contact"><i class="fas fa-envelope fa-fw"></i> Contact</a>
      <a href="/my-orders"><i class="fas fa-box fa-fw"></i> My Orders</a>
      <a href="/checkout" class="cart-mobile"><i class="fas fa-shopping-cart"></i> View Cart</a>
    </div>
  </nav>
</header>

<script>
  // ─── Scroll effect ───
  const nav = document.getElementById('prNavbar');
  window.addEventListener('scroll', () => {
    nav.classList.toggle('scrolled', window.scrollY > 30);
  }, { passive: true });

  // ─── Hamburger toggle ───
  const ham = document.getElementById('prHamburger');
  const mob = document.getElementById('prMobileMenu');
  ham.addEventListener('click', () => {
    const open = mob.classList.toggle('open');
    ham.classList.toggle('open', open);
    ham.setAttribute('aria-expanded', open);
  });

  // ─── Active link highlight ───
  const path = window.location.pathname;
  document.querySelectorAll('.pr-nav-links a, .pr-mobile-menu a').forEach(a => {
    if (a.getAttribute('href') === path || (path !== '/' && a.getAttribute('href') !== '/' && path.startsWith(a.getAttribute('href')))) {
      a.classList.add('active');
    }
  });
</script>