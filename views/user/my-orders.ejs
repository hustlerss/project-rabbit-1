<%- include('navbar.ejs') %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Orders | Project Rabbit</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background: var(--bg-primary) !important; color: #fff !important; }
        .hero {
            background: radial-gradient(ellipse 100% 100% at 50% 0%, #15092a 0%, #050816 100%) !important;
            color: #fff !important;
            padding: 60px 0 40px !important;
            text-align: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;
        }
        .hero h1 { font-weight: 800; font-size: 36px; color: #ffffff !important; }
        .hero p { color: var(--text-secondary) !important; }
        .order-card {
            background: rgba(11, 16, 32, 0.6) !important;
            backdrop-filter: var(--glass-blur) !important;
            -webkit-backdrop-filter: var(--glass-blur) !important;
            border: 1px solid var(--border-light) !important;
            border-radius: 20px !important;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35) !important;
            margin-bottom: 20px;
            overflow: hidden;
            color: #fff !important;
            transition: all 0.3s ease;
        }
        .order-card:hover {
            transform: translateY(-3px);
            border-color: rgba(255, 59, 112, 0.25) !important;
            box-shadow: 0 15px 35px rgba(255, 59, 112, 0.08) !important;
        }
        .order-header {
            background: rgba(255, 255, 255, 0.02) !important;
            padding: 18px 22px !important;
            border-bottom: 1px solid rgba(255, 255, 255, 0.06) !important;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
            color: #fff !important;
        }
        .order-body { padding: 22px !important; color: #fff !important; }
        .badge-paid {
            background: rgba(16, 185, 129, 0.08) !important;
            border: 1px solid rgba(16, 185, 129, 0.25) !important;
            color: #10b981 !important;
            padding: 6px 14px !important;
            border-radius: 20px !important;
            font-size: 11px !important;
            font-weight: 700 !important;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .btn-download {
            background: var(--btn-gradient) !important;
            color: #fff !important;
            border: none !important;
            border-radius: 12px !important;
            padding: 10px 24px !important;
            font-weight: 700 !important;
            text-decoration: none;
            transition: all 0.3s;
            box-shadow: 0 4px 14px rgba(255, 59, 112, 0.3) !important;
        }
        .btn-download:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(255, 59, 112, 0.45) !important; color: #fff; }
        .search-box {
            background: rgba(255, 255, 255, 0.02) !important;
            border: 1px solid var(--border-light) !important;
            color: #fff !important;
            border-radius: 30px !important;
            padding: 12px 22px !important;
            width: 400px;
            max-width: 95%;
            outline: none !important;
            transition: all 0.25s ease !important;
        }
        .search-box::placeholder { color: rgba(255, 255, 255, 0.35) !important; }
        .search-box:focus {
            background: rgba(255, 255, 255, 0.04) !important;
            border-color: rgba(255, 59, 112, 0.45) !important;
            box-shadow: 0 0 0 4px rgba(255, 59, 112, 0.12) !important;
        }
        h1, h2, h3, h4, h5, h6, .fw-bold { color: #fff !important; }
        .text-muted { color: var(--text-secondary) !important; }
        code { background: rgba(255, 59, 112, 0.08) !important; color: #ff5e89 !important; padding: 3px 8px !important; border-radius: 6px !important; font-size: 12px !important; border: 1px solid rgba(255, 59, 112, 0.15) !important; }
    </style>
</head>
<body>

<div class="hero">
    <h1><i class="fas fa-box me-2" style="color:#e94560;"></i>My Orders</h1>
    <p class="opacity-75 mb-4">Find and download your purchased projects</p>
    <form method="GET" action="/my-orders" class="d-flex justify-content-center gap-2 flex-wrap">
        <input type="email" name="email" class="search-box" placeholder="Enter your email to find orders..." value="<%= email %>" required>
        <button type="submit" class="btn" style="background:#e94560;color:#fff;border-radius:30px;padding:12px 25px;font-weight:600;">
            <i class="fas fa-search me-1"></i> Search
        </button>
    </form>
</div>

<div class="container my-5" style="max-width:900px;">
    <% if (email && orders.length === 0) { %>
        <div class="text-center py-5">
            <div style="font-size:60px;">📭</div>
            <h4 class="mt-3 text-muted">No orders found for <strong><%= email %></strong></h4>
            <p class="text-muted">If you made a purchase, check the email address and try again.</p>
            <a href="/" class="btn btn-outline-danger mt-2">Browse Projects</a>
        </div>
    <% } else if (orders.length > 0) { %>
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h5 class="fw-bold"><%= orders.length %> order(s) found for <span class="text-danger"><%= email %></span></h5>
        </div>
        <% orders.forEach((order, i) => { %>
        <div class="order-card">
            <div class="order-header">
                <div>
                    <small class="text-muted">Order #<%= i + 1 %></small>
                    <div class="fw-bold"><%= order.project_title %></div>
                    <small class="text-muted">
                        <i class="fas fa-calendar me-1"></i>
                        <%= new Date(order.created_at).toLocaleDateString('en-IN', { day:'2-digit', month:'long', year:'numeric' }) %>
                    </small>
                </div>
                <div class="text-end">
                    <span class="badge-paid"><i class="fas fa-check me-1"></i><%= order.status %></span>
                    <div class="fw-bold mt-1 text-success fs-5">₹<%= parseFloat(order.amount).toFixed(2) %></div>
                </div>
            </div>
            <div class="order-body d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <div class="mb-1"><i class="fas fa-fingerprint me-2 text-muted"></i><small class="text-muted">Payment ID: </small><code><%= order.payment_id %></code></div>
                    <div><i class="fas fa-tag me-2 text-muted"></i><small class="badge bg-light text-dark border"><%= order.project_type %></small></div>
                </div>
                <a href="/download/<%= order.payment_id %>/<%= order.project_type %>/<%= order.project_id %>" class="btn-download">
                    <i class="fas fa-download me-2"></i>Download Project
                </a>
            </div>
        </div>
        <% }) %>
    <% } else { %>
        <div class="text-center py-5">
            <div style="font-size:60px;">🔍</div>
            <h4 class="mt-3 text-muted">Enter your email address above to find your orders</h4>
        </div>
    <% } %>
</div>

<%- include('footer.ejs') %>
</body>
</html>
