<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ProjectHub — Premium Academic Projects Marketplace</title>
<meta name="description" content="Buy ready-made academic projects with full source code, documentation, PPT &amp; report. BCA, MCA, B.Tech, MBA projects at best prices. Instant download via Razorpay.">
</head>
<body>

<%- include('navbar.ejs') %>

<style>
  /* ─── NEW ASYMMETRICAL SPLIT HERO ─── */
  .hero {
    min-height: calc(100vh - 84px); /* Combined with body padding-top, fits 100vh exactly */
    display: flex; align-items: center; justify-content: center;
    position: relative; overflow: hidden;
    padding: 40px 24px 20px; /* Refined padding for full viewport layout */
    background: radial-gradient(ellipse 140% 100% at 50% 0%, #15092a 0%, #060714 55%, #050816 100%);
  }
  
  /* Modern Grid Overlay background */
  .hero::before {
    content: '';
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(255, 59, 112, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 59, 112, 0.04) 1px, transparent 1px);
    background-size: 55px 55px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 15%, black 0%, transparent 80%);
    pointer-events: none;
    z-index: 1;
  }
  
  /* Aurora Backlights & Spotlight treatments */
  .hero-spotlight {
    position: absolute; width: 650px; height: 650px;
    background: radial-gradient(circle, rgba(144, 59, 255, 0.15) 0%, transparent 70%);
    top: -180px; right: 5%; filter: blur(120px); pointer-events: none; z-index: 1;
    animation: drift 15s ease-in-out infinite;
  }
  .hero-aurora {
    position: absolute; width: 450px; height: 450px;
    background: radial-gradient(circle, rgba(255, 59, 112, 0.12) 0%, transparent 70%);
    bottom: -80px; right: 25%; filter: blur(100px); pointer-events: none; z-index: 1;
    animation: drift 20s ease-in-out infinite reverse;
  }
  @keyframes drift { 
    0%, 100% { transform: translateY(0) scale(1) rotate(0deg); } 
    50% { transform: translateY(-30px) scale(1.05) rotate(10deg); } 
  }

  .hero-container {
    max-width: 1200px; margin: 0 auto; width: 100%;
    display: grid; grid-template-columns: 1.15fr 0.85fr;
    gap: 60px; align-items: center; position: relative; z-index: 5;
  }
  @media(max-width: 991px){
    .hero-container { grid-template-columns: 1fr; text-align: center; gap: 48px; }
  }

  /* LEFT COLUMN: Editorial Typography & Actions */
  .hero-left {
    display: flex; flex-direction: column; align-items: flex-start;
  }
  @media(max-width: 991px){
    .hero-left { align-items: center; }
  }

  .hero-pill {
    display: inline-flex; align-items: center; gap: 8px;
    background: rgba(255, 59, 112, 0.07);
    border: 1px solid rgba(255, 59, 112, 0.25);
    color: #ff5e89; padding: 8px 18px; border-radius: 40px;
    font-size: 12.5px; font-weight: 700; margin-bottom: 28px;
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 8px 24px rgba(255, 59, 112, 0.1);
  }
  .pulse-dot {
    width: 6px; height: 6px; border-radius: 50%; background: #ff3b70;
    box-shadow: 0 0 10px #ff3b70; animation: pingDot 2s ease infinite;
  }
  @keyframes pingDot { 0%{box-shadow:0 0 0 0 rgba(255,59,112,0.8)} 70%{box-shadow:0 0 0 10px transparent} 100%{box-shadow:0 0 0 0 transparent} }

  .hero h1 {
    font-size: clamp(44px, 6.2vw, 76px) !important;
    font-weight: 900 !important;
    line-height: 1.05 !important;
    letter-spacing: -0.04em !important;
    color: #fff !important;
    margin-bottom: 24px !important;
    text-align: left;
  }
  @media(max-width: 991px){
    .hero h1 { text-align: center; }
  }
  
  .glow-text {
    background: var(--accent-gradient);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    filter: drop-shadow(0 0 45px rgba(255, 59, 112, 0.3));
  }
  
  .hero-description {
    color: var(--text-secondary); font-size: clamp(16px, 1.8vw, 18px); line-height: 1.65;
    max-width: 580px; margin-bottom: 34px; text-align: left;
  }
  @media(max-width: 991px){
    .hero-description { text-align: center; margin: 0 auto 34px; }
  }

  /* AI Glowing Search Input */
  .hero-ai-search {
    display: flex; width: 100%; max-width: 480px;
    background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border-light);
    border-radius: 16px; overflow: hidden; backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    margin-bottom: 32px;
  }
  .hero-ai-search:focus-within {
    border-color: rgba(255, 59, 112, 0.45);
    box-shadow: 0 15px 40px rgba(255, 59, 112, 0.12), 0 0 0 1px rgba(255, 59, 112, 0.1);
  }
  .ai-spark {
    padding-left: 18px; display: flex; align-items: center;
    color: var(--accent-pink); font-size: 16px; pointer-events: none;
  }
  .hero-ai-search input {
    flex: 1; background: transparent; border: none; color: #fff; padding: 14px 14px;
    font-size: 14.5px; outline: none;
  }
  .hero-ai-search input::placeholder { color: rgba(255, 255, 255, 0.3); }
  .hero-ai-search button {
    background: var(--btn-gradient); border: none; color: #fff;
    padding: 14px 24px; font-weight: 700; font-size: 13.5px; cursor: pointer;
    transition: all 0.2s;
  }
  .hero-ai-search button:hover { filter: brightness(1.1); }

  /* Hero Actions buttons */
  .hero-action-buttons { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 40px; }
  .btn-glow {
    display: inline-flex; align-items: center; gap: 9px;
    background: var(--btn-gradient);
    color: #fff; padding: 16px 34px; border-radius: 14px;
    text-decoration: none; font-weight: 700; font-size: 15px;
    box-shadow: 0 8px 24px rgba(255, 59, 112, 0.35);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .btn-glow:hover { transform: translateY(-3px); box-shadow: 0 12px 36px rgba(255, 59, 112, 0.5); color: #fff; filter: brightness(1.1); }
  
  .btn-ghost {
    display: inline-flex; align-items: center; gap: 9px;
    background: rgba(255, 255, 255, 0.03); color: #fff; padding: 16px 34px; border-radius: 14px;
    text-decoration: none; font-weight: 600; font-size: 15px;
    border: 1px solid var(--border-light);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
  }
  .btn-ghost:hover { background: rgba(255, 255, 255, 0.08); border-color: rgba(255, 255, 255, 0.3); transform: translateY(-2px); color: #fff; }

  /* Editorial Trust Stats Row */
  .hero-stats-row {
    display: flex; gap: 40px; margin-top: 10px;
  }
  .editorial-stat { display: flex; flex-direction: column; align-items: flex-start; }
  @media(max-width: 991px){
    .hero-stats-row { justify-content: center; }
  }
  .edit-stat-num {
    font-size: 34px; font-weight: 900; color: #fff; line-height: 1; letter-spacing: -0.02em;
    font-family: 'Plus Jakarta Sans', sans-serif !important;
  }
  .edit-stat-num span { background: var(--accent-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
  .edit-stat-lbl { font-size: 12px; color: var(--text-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; margin-top: 6px; }

  /* ─── NEW STATS BAR ─── */
  .stats-bar {
    position: relative;
    padding: 50px 0;
    background: #050816;
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
    z-index: 10;
  }
  .stat-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .stat-item {
    text-align: center;
    position: relative;
  }
  .stat-item:not(:last-child)::after {
    content: '';
    position: absolute;
    right: -12px;
    top: 20%;
    bottom: 20%;
    width: 1px;
    background: linear-gradient(to bottom, transparent, var(--border-light), transparent);
  }
  .stat-num {
    font-size: clamp(32px, 3.8vw, 48px);
    font-weight: 900;
    color: #fff;
    line-height: 1;
    font-family: 'Plus Jakarta Sans', sans-serif !important;
    letter-spacing: -0.02em;
  }
  .stat-num span {
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .stat-label {
    font-size: 12.5px;
    color: var(--text-muted);
    margin-top: 8px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.2px;
  }
  @media(max-width: 768px) {
    .stat-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 36px 12px;
    }
    .stat-item::after { display: none; }
  }

  /* RIGHT COLUMN: Layered Floating UI panels */
  .hero-right {
    display: flex; justify-content: center; position: relative; width: 100%;
  }
  .glass-canvas {
    width: 100%; max-width: 440px; height: 410px; position: relative; /* Increased height for breathing room */
  }
  @media(max-width: 991px){
    .glass-canvas { height: 320px; }
  }

  /* Spotlight behind right column elements */
  .canvas-spot {
    position: absolute; inset: 10%;
    background: radial-gradient(circle, rgba(144, 59, 255, 0.22) 0%, transparent 70%);
    filter: blur(50px); pointer-events: none; z-index: 1;
  }

  /* Floating glass cards properties */
  .floating-panel {
    position: absolute;
    background: rgba(13, 14, 33, 0.6) !important;
    backdrop-filter: blur(20px) !important;
    -webkit-backdrop-filter: blur(20px) !important;
    border: 1px solid rgba(255, 255, 255, 0.08) !important;
    border-radius: 20px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
    z-index: 2;
  }

  /* Panel 1: Ready-to-submit MERN Card */
  .panel-1 {
    width: 280px; top: 0px; left: -20px; /* Offset left and higher for spacing */
    animation: panelFloat1 6s ease-in-out infinite;
  }
  @keyframes panelFloat1 {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
  }
  .panel-header {
    padding: 12px 16px; border-bottom: 1px solid rgba(255,255,255,0.06);
    display: flex; align-items: center; gap: 6px;
  }
  .panel-dot { width: 8px; height: 8px; border-radius: 50%; }
  .panel-dot.red { background: #ff5f56; }
  .panel-dot.yellow { background: #ffbd2e; }
  .panel-dot.green { background: #27c93f; }
  .panel-title { font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; margin-left: 4px; }
  
  .panel-body { padding: 18px 20px; }
  .panel-body .preview-badge {
    background: rgba(0, 240, 255, 0.08); border: 1px solid rgba(0, 240, 255, 0.25);
    color: var(--accent-cyan); font-size: 9.5px; font-weight: 800; text-transform: uppercase;
    display: inline-block; padding: 4px 10px; border-radius: 30px; margin-bottom: 12px;
  }
  .panel-body h3 { font-size: 16px; font-weight: 800; color: #fff; margin-bottom: 6px; }
  .panel-body p { font-size: 12.5px; color: var(--text-secondary); margin-bottom: 14px; }
  .panel-body .preview-footer { display: flex; justify-content: space-between; align-items: center; }
  .panel-body .preview-price { font-size: 16px; font-weight: 800; color: var(--accent-pink); }
  .panel-body .preview-btn {
    font-size: 11px; font-weight: 700; color: #fff; text-decoration: none;
    background: rgba(255,255,255,0.08); padding: 5px 12px; border-radius: 8px;
    border: 1px solid rgba(255,255,255,0.06); transition: all 0.2s;
  }
  .panel-body .preview-btn:hover { background: rgba(255,255,255,0.15); }

  /* Panel 2: Live activity chart */
  .panel-2 {
    width: 240px; bottom: 10px; right: -25px; /* Offset right and lower for spacing */
    padding: 16px 20px;
    animation: panelFloat2 8s ease-in-out infinite 1s;
    z-index: 3;
  }
  @keyframes panelFloat2 {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-16px); }
  }
  .chart-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
  .chart-header span { font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; }
  .chart-status { display: inline-flex; align-items: center; gap: 5px; color: #10b981 !important; font-weight: 800 !important; }
  .chart-status::before { content:''; width: 5px; height: 5px; background: #10b981; border-radius: 50%; box-shadow: 0 0 6px #10b981; }
  
  .chart-graph { width: 100%; height: 60px; display: flex; align-items: flex-end; margin-bottom: 10px; }
  .sparkline { width: 100%; height: 100%; overflow: visible; }
  
  .chart-footer { display: flex; justify-content: space-between; align-items: center; font-size: 11.5px; }
  .chart-footer span { color: var(--text-secondary); }
  .chart-val { font-weight: 800; color: #10b981; }

  /* Panel 3: Floating Tech chips */
  .panel-3 {
    padding: 10px 14px; top: 220px; left: 110px; /* Offset lower and right into the visual gap */
    animation: panelFloat1 7s ease-in-out infinite 0.5s;
    z-index: 4;
  }
  .tech-stack-row { display: flex; gap: 8px; }
  .tech-tag {
    background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.06);
    font-size: 10px; font-weight: 700; color: var(--text-secondary);
    padding: 4px 10px; border-radius: 30px; text-transform: uppercase;
  }

  /* ─── SECTION COMMON STYLING ─── */
  .sec { padding: 120px 24px; max-width: 1240px; margin: 0 auto; position: relative; }
  .sec-tag {
    background: rgba(255, 59, 112, 0.08);
    border: 1px solid rgba(255, 59, 112, 0.2);
    color: var(--accent-pink); font-size: 11px; font-weight: 700;
    text-transform: uppercase; letter-spacing: 2px; margin-bottom: 18px;
    display: inline-block; padding: 6px 16px; border-radius: 20px;
  }
  .sec-title { font-size: clamp(32px, 4.5vw, 48px); font-weight: 900; letter-spacing: -0.025em; line-height: 1.15; margin-bottom: 18px; }
  .sec-title span { background: var(--accent-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
  .sec-sub { color: var(--text-secondary); font-size: 17px; line-height: 1.7; max-width: 620px; }
  .sec-divider { width: 60px; height: 4px; border-radius: 4px; background: var(--accent-gradient); margin: 24px 0 60px; }

  /* ─── CATEGORY BENTO CARDS ─── */
  .categories-section { background: #050816; position: relative; }
  .categories-section::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 350px;
    background: linear-gradient(to bottom, #060714, transparent); pointer-events: none;
  }
  .cat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  @media(max-width:991px){ .cat-grid{grid-template-columns: repeat(2, 1fr);} }
  @media(max-width:600px){ .cat-grid{grid-template-columns: 1fr;} }

  .cat-card {
    position: relative; border-radius: 24px; overflow: hidden;
    background: rgba(11, 16, 32, 0.5) !important; border: 1px solid var(--border-light) !important;
    text-decoration: none; display: flex; flex-direction: column;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1) !important;
    min-height: 290px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35) !important;
  }
  .cat-card:hover {
    transform: translateY(-8px) !important;
    border-color: rgba(255, 59, 112, 0.35) !important;
    box-shadow: 0 20px 45px rgba(255, 59, 112, 0.12), 0 0 0 1px rgba(255, 59, 112, 0.06) !important;
  }

  .cat-img { position: absolute; inset: 0; z-index: 1; }
  .cat-img img { width: 100%; height: 100%; object-fit: cover; opacity: 0.22; transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1); }
  .cat-card:hover .cat-img img { opacity: 0.36; transform: scale(1.06); }
  
  .cat-overlay {
    position: absolute; inset: 0; z-index: 2;
    background: linear-gradient(to top, rgba(5, 8, 22, 0.98) 0%, rgba(5, 8, 22, 0.45) 60%, rgba(5, 8, 22, 0.1) 100%);
  }

  .cat-badge-pill {
    position: absolute; top: 20px; left: 20px; z-index: 3;
    background: var(--btn-gradient); color: #fff;
    font-size: 11px; font-weight: 700; padding: 6px 14px; border-radius: 20px;
    box-shadow: 0 6px 15px rgba(255, 59, 112, 0.35);
    letter-spacing: 0.5px; text-transform: uppercase;
  }

  .cat-content { position: relative; z-index: 3; margin-top: auto; padding: 26px; }
  .cat-emoji { font-size: 32px; margin-bottom: 12px; display: block; filter: drop-shadow(0 4px 12px rgba(0,0,0,0.5)); }
  .cat-name { font-size: 19px; font-weight: 800; color: #fff; margin-bottom: 8px; }
  .cat-desc { font-size: 13.5px; color: var(--text-secondary); line-height: 1.6; margin-bottom: 18px; }
  .cat-footer { display: flex; align-items: center; justify-content: space-between; }
  .cat-price { font-size: 17px; font-weight: 800; color: var(--accent-pink); }
  .cat-arrow {
    width: 38px; height: 38px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
    background: rgba(255, 59, 112, 0.12); color: var(--accent-pink); font-size: 13px;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    border: 1px solid rgba(255, 59, 112, 0.2);
  }
  .cat-card:hover .cat-arrow {
    background: var(--accent-pink); color: #fff; border-color: transparent;
    transform: rotate(-45deg) scale(1.05);
    box-shadow: 0 4px 15px rgba(255, 59, 112, 0.4);
  }

  /* ─── PROCESS STEPS ─── */
  .how-section { background: #0b1020; position: relative; }
  .steps-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; position: relative; z-index: 2; }
  @media(max-width:768px){ .steps-row{grid-template-columns: 1fr;} }
  
  .step-card {
    text-align: center; padding: 48px 32px;
    background: rgba(11, 16, 32, 0.4) !important; border: 1px solid var(--border-light) !important;
    border-radius: 24px; position: relative; transition: all 0.3s;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25) !important;
  }
  .step-card:hover {
    border-color: rgba(144, 59, 255, 0.3) !important;
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(144, 59, 255, 0.08) !important;
  }
  .step-num {
    width: 68px; height: 68px; margin: 0 auto 24px;
    background: linear-gradient(135deg, var(--accent-pink), var(--accent-purple));
    border-radius: 50%; display: flex; align-items: center; justify-content: center;
    font-size: 26px; font-weight: 900; color: #fff;
    box-shadow: 0 8px 24px rgba(255, 59, 112, 0.4);
    position: relative; z-index: 2;
  }
  .step-card h5 { font-size: 19px; font-weight: 800; color: #fff; margin-bottom: 12px; }
  .step-card p { font-size: 14px; color: var(--text-secondary); line-height: 1.65; }

  /* ─── WHY CHOOSE US (Bento Grid) ─── */
  .features-section { background: #050816; }
  .feat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  @media(max-width:991px){ .feat-grid{grid-template-columns: repeat(2, 1fr);} }
  @media(max-width:600px){ .feat-grid{grid-template-columns: 1fr;} }

  .feat-card {
    background: rgba(11, 16, 32, 0.45) !important; border: 1px solid var(--border-light) !important;
    border-radius: 24px; padding: 40px 32px; transition: all 0.3s;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25) !important;
  }
  .feat-card:hover {
    border-color: rgba(0, 240, 255, 0.3) !important;
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(0, 240, 255, 0.08) !important;
  }
  .feat-icon {
    width: 60px; height: 60px; border-radius: 18px;
    display: flex; align-items: center; justify-content: center;
    font-size: 28px; margin-bottom: 22px;
    border: 1px solid rgba(255,255,255,0.06);
    box-shadow: inset 0 2px 6px rgba(255,255,255,0.05);
  }
  .feat-card h5 { font-size: 18px; font-weight: 800; color: #fff; margin-bottom: 10px; }
  .feat-card p { font-size: 14px; color: var(--text-secondary); line-height: 1.65; }

  /* ─── STUDENT REVIEWS ─── */
  .testi-section { background: #0b1020; }
  .testi-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  @media(max-width:991px){ .testi-grid{grid-template-columns: repeat(2, 1fr);} }
  @media(max-width:600px){ .testi-grid{grid-template-columns: 1fr;} }
  
  .testi-card {
    background: rgba(11, 16, 32, 0.45) !important; border: 1px solid var(--border-light) !important;
    border-radius: 24px; padding: 36px; position: relative;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25) !important;
  }
  .testi-card::before { content: '“'; position: absolute; top: 12px; right: 28px; font-size: 72px; color: rgba(255, 59, 112, 0.12); font-family: 'Plus Jakarta Sans', sans-serif; line-height: 1; }
  .testi-stars { color: #fbbf24; font-size: 16px; margin-bottom: 16px; letter-spacing: 3px; }
  .testi-text { font-size: 14.5px; color: var(--text-secondary); line-height: 1.8; font-style: italic; margin-bottom: 24px; }
  .testi-author { display: flex; align-items: center; gap: 14px; }
  .testi-avatar { width: 50px; height: 50px; border-radius: 50%; object-fit: cover; border: 2px solid rgba(255, 59, 112, 0.35); }
  .testi-name { font-size: 15px; font-weight: 700; color: #fff; }
  .testi-college { font-size: 12px; color: var(--text-muted); margin-top: 2px; }

